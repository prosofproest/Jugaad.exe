{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "PS-03 design tokens",
    "version": "0.1.0",
    "status": "draft",
    "updated": "2026-11-06",
    "source": "final/feature-specs/01-design-system.md",
    "notes": [
      "Semantic tokens only. Components must not hard-code raw values.",
      "Risk and status are separate axes and must never be cross-passed.",
      "No dark theme in v1; do not add partial dark tokens."
    ]
  },
  "color": {
    "surface": {
      "default": "#ffffff",
      "raised": "#ffffff",
      "sunken": "#e8ebe6",
      "overlay": "#0e0f0c"
    },
    "text": {
      "primary": "#0e0f0c",
      "secondary": "#454745",
      "disabled": "#868685",
      "inverse": "#ffffff"
    },
    "border": {
      "subtle": "#dfe4da",
      "strong": "#b9c1b3",
      "focus": "#0b5fff"
    },
    "brand": {
      "primary": "#9fe870",
      "primaryHover": "#8bd85c",
      "onPrimary": "#0e0f0c"
    },
    "risk": {
      "low": "#2f6f4e",
      "moderate": "#9a6700",
      "high": "#c2410c",
      "urgent": "#b42318",
      "insufficient": "#5f6b7a"
    },
    "status": {
      "queued": "#4b5563",
      "syncing": "#1d4ed8",
      "synced": "#047857",
      "pending_review": "#7c3aed",
      "confirmed": "#065f46",
      "probable": "#92400e",
      "rejected": "#991b1b",
      "duplicate": "#6b7280",
      "needs_visit": "#a16207",
      "unresolved": "#475569"
    },
    "feedback": {
      "error": "#b42318",
      "warning": "#9a6700",
      "success": "#067647",
      "info": "#175cd3"
    }
  },
  "font": {
    "family": {
      "sans": "system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "size": {
      "display": "2rem",
      "h1": "1.5rem",
      "h2": "1.25rem",
      "body": "1rem",
      "small": "0.875rem",
      "caption": "0.75rem"
    },
    "lineHeight": {
      "display": "2.5rem",
      "h1": "2rem",
      "h2": "1.75rem",
      "body": "1.5rem",
      "small": "1.25rem",
      "caption": "1rem"
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "control": "8px",
    "card": "12px",
    "chip": "999px"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "breakpoint": {
    "sm": "640px",
    "md": "1024px",
    "lg": "1440px",
    "xl": "1920px"
  }
}
