# Staging variable template. Names only — values come from the secret store.
#
# This file is documentation, not a runnable env file. POSTGRES_PASSWORD is
# blank on purpose so `docker compose` fails closed if it is used verbatim.
POSTGRES_USER=ps03
POSTGRES_PASSWORD=
POSTGRES_DB=ps03

APP_ENVIRONMENT=staging
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=true

API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=https://staging.example.invalid
NEXT_PUBLIC_API_BASE_URL=https://staging.example.invalid
