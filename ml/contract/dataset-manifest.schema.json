{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ps03.local/schemas/dataset-manifest.schema.json",
  "title": "PS-03 dataset manifest",
  "description": "Contract for the only way training data may enter the ML scaffold. Synthetic fixtures must be labelled demo; field datasets must record licence and permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "description",
    "fixture_kind",
    "is_demo",
    "created_at",
    "licence",
    "provenance",
    "feature_contract_version",
    "feature_dim",
    "taxonomy_version",
    "classes",
    "data_file",
    "data_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "fixture_kind": {
      "type": "string",
      "enum": ["synthetic_fixture", "field_dataset"]
    },
    "is_demo": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "feature_contract_version": {
      "type": "string",
      "minLength": 1
    },
    "feature_dim": {
      "type": "integer",
      "minimum": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "classes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "display_name"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "data_file": {
      "type": "string",
      "minLength": 1,
      "description": "Path to a JSONL file, relative to this manifest when not absolute."
    },
    "data_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "items_count": {
      "type": "integer",
      "minimum": 1
    },
    "personal_data": {
      "type": "boolean"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consent_ref": {
          "type": "string",
          "minLength": 1
        },
        "ethics_ref": {
          "type": "string",
          "minLength": 1
        },
        "data_owner": {
          "type": "string",
          "minLength": 1
        },
        "privacy_review_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fixture_kind": {
            "const": "synthetic_fixture"
          }
        },
        "required": ["fixture_kind"]
      },
      "then": {
        "properties": {
          "is_demo": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fixture_kind": {
            "const": "field_dataset"
          }
        },
        "required": ["fixture_kind"]
      },
      "then": {
        "properties": {
          "is_demo": {
            "const": false
          }
        },
        "required": ["permissions"]
      }
    }
  ]
}
