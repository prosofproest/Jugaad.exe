# Web client environment (copy to .env.local for local development).
#
# The browser talks to the FastAPI service only. It never receives database
# credentials. NEXT_PUBLIC_* values are embedded in the client bundle, so they
# must never hold a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional, server-only: where Next.js server components reach the API.
# Compose sets this to http://api:8000; outside Docker the default is fine.
# API_BASE_URL=http://api:8000
